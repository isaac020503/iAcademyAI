PORT=3000

# Required for all AI features (chat assistant, lecture generator, coach).
# Create a key at https://platform.openai.com/api-keys. It stays on the server.
OPENAI_API_KEY=

# Default model, plus the list offered in the model picker (comma separated).
# Use model names that your OpenAI account has access to.
OPENAI_MODEL=gpt-5
OPENAI_MODELS=

# Limits (per signed-in user)
AI_RATE_LIMIT_PER_MIN=20
AI_DAILY_TOKEN_LIMIT=300000

# Optional: USD per 1M tokens, to show an estimated cost in the status bar.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
